{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Muyecode",
  "scopeName": "source.muyecode",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#functionCalls"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.muyecode",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.muyecode",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.muyecode",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.muyecode",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.muyecode",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.muyecode",
          "match": "\\b-?(?:\\d+\\.\\d+|\\d+|\\.\\d+)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.muyecode",
          "match": "\\b(?:if|else|while|for|return|end|this|new)\\b"
        },
        {
          "name": "storage.type.muyecode",
          "match": "\\b(?:value|let|set|change|function|class|method|get|cmp|declare)\\b"
        },
        {
          "name": "support.function.builtin.muyecode",
          "match": "\\b(?:print|say|input|len|str|num|random|key|pressed|push|removefirst|openfile|writefile|appendfile|canvas|pen|fill|line|rect|box|circle|text|clear|wait|sleep)\\b"
        },
        {
          "name": "constant.language.boolean.muyecode",
          "match": "\\b(?:true|false|null)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.value.declaration.muyecode",
          "match": "\\b(value|let)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.muyecode"
            },
            "2": {
              "name": "variable.other.assignment.muyecode"
            }
          }
        },
        {
          "name": "meta.set.statement.muyecode",
          "match": "\\b(set|change)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.muyecode"
            },
            "2": {
              "name": "variable.other.readwrite.muyecode"
            }
          }
        },
        {
          "name": "variable.other.readwrite.muyecode",
          "match": "(?<=,)\\s*([A-Za-z_][A-Za-z0-9_]*)(?=\\s*=)",
          "captures": {
            "1": {
              "name": "variable.other.readwrite.muyecode"
            }
          }
        },
        {
          "name": "meta.class.declaration.muyecode",
          "match": "\\b(class)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.muyecode"
            },
            "2": {
              "name": "entity.name.type.class.muyecode"
            }
          }
        },
        {
          "name": "meta.method.declaration.muyecode",
          "match": "\\b(method)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\()([^)]*)(\\))",
          "captures": {
            "1": {
              "name": "storage.type.muyecode"
            },
            "2": {
              "name": "entity.name.function.muyecode"
            },
            "3": {
              "name": "punctuation.definition.parameters.begin.muyecode"
            },
            "4": {
              "name": "variable.parameter.muyecode"
            },
            "5": {
              "name": "punctuation.definition.parameters.end.muyecode"
            }
          }
        },
        {
          "name": "meta.function.declaration.muyecode",
          "match": "\\b(function)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\()([^)]*)(\\))",
          "captures": {
            "1": {
              "name": "storage.type.muyecode"
            },
            "2": {
              "name": "entity.name.function.muyecode"
            },
            "3": {
              "name": "punctuation.definition.parameters.begin.muyecode"
            },
            "4": {
              "name": "variable.parameter.muyecode"
            },
            "5": {
              "name": "punctuation.definition.parameters.end.muyecode"
            }
          }
        }
      ]
    },
    "functionCalls": {
      "patterns": [
        {
          "name": "support.function.call.muyecode",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.readwrite.muyecode",
          "match": "\\b(?!(?:value|let|set|change|function|class|method|get|cmp|declare|if|else|while|for|return|end|this|new|print|say|input|len|str|num|random|key|pressed|push|removefirst|openfile|writefile|appendfile|canvas|pen|fill|line|rect|box|circle|text|clear|wait|sleep|true|false|null)\\b)[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.muyecode",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.muyecode",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.muyecode",
          "match": "\\+|-|\\*|/"
        }
      ]
    }
  }
}

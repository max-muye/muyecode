canvas 400 400 "black"

class SnakeGame
    value size = 20
    value snake = [{x: 200, y: 200}]
    value food = this.newFood()
    value dx = this.size
    value dy = 0
    value score = 0
    value alive = true
    value running = true

    method newFood()
        return {x: random(20) * this.size, y: random(20) * this.size}
    end

    method reset()
        change this.snake = [{x: 200, y: 200}]
        change this.food = this.newFood()
        change this.dx = this.size
        change this.dy = 0
        change this.score = 0
        change this.alive = true
        change this.running = true
    end

    method readKeys()
        if key("r") || key("R")
            this.reset()
        end

        if key("q") || key("Q")
            change this.running = false
        end

        if key("ArrowUp") && this.dy == 0
            change this.dx = 0
            change this.dy = -this.size
        end

        if key("ArrowDown") && this.dy == 0
            change this.dx = 0
            change this.dy = this.size
        end

        if key("ArrowLeft") && this.dx == 0
            change this.dx = -this.size
            change this.dy = 0
        end

        if key("ArrowRight") && this.dx == 0
            change this.dx = this.size
            change this.dy = 0
        end
    end

    method move()
        let head = {x: this.snake[0].x + this.dx, y: this.snake[0].y + this.dy}

        if head.x < 0 || head.x >= 400 || head.y < 0 || head.y >= 400
            change this.alive = false
        end

        let i = 0
        while i < len(this.snake)
            if head.x == this.snake[i].x && head.y == this.snake[i].y
                change this.alive = false
            end
            change i = i + 1
        end

        if this.alive
            this.snake.unshift(head)

            if head.x == this.food.x && head.y == this.food.y
                change this.score = this.score + 1
                change this.food = this.newFood()
            else
                this.snake.pop()
            end
        end
    end

    method draw()
        clear "black"

        fill "#22c55e"
        let part = 0
        while part < len(this.snake)
            box this.snake[part].x this.snake[part].y this.size
            change part = part + 1
        end

        fill "#ef4444"
        box this.food.x this.food.y this.size

        pen "white" 1
        text 12 28 "Score:" 20
        text 82 28 this.score 20

        if !this.alive
            text 120 205 "Game Over" 32
            text 108 238 "Press R to restart" 18
        end

        if !this.running
            text 150 205 "Quit" 32
        end
    end

    method run()
        while this.running
            this.readKeys()

            if this.alive
                this.move()
            end

            this.draw()
            wait 120
        end

        this.draw()
    end
end

let game = new SnakeGame()
game.run()

canvas 400 400 "black"

class SnakeGame
    value size = 20
    value snake = [{x: 200, y: 200}]
    value food = this.newFood()
    value dx = this.size
    value dy = 0
    value score = 0
    value alive = true
    value running = true
    value moves = []
    value upPressed = false
    value downPressed = false
    value leftPressed = false
    value rightPressed = false

    method newFood()
        return {x: random(20) * this.size, y: random(20) * this.size}
    end

    method reset()
        change this.snake = [{x: 200, y: 200}]
        change this.food = this.newFood()
        change this.dx = this.size
        change this.dy = 0
        change this.score = 0
        change this.alive = true
        change this.running = true
        change this.moves = []
        change this.upPressed = false
        change this.downPressed = false
        change this.leftPressed = false
        change this.rightPressed = false
    end

    method queueMove(x, y)
        let last = {x: this.dx, y: this.dy}

        if len(this.moves) > 0
            change last = this.moves[len(this.moves) - 1]
        end

        if (x != last.x || y != last.y) && (x + last.x != 0 || y + last.y != 0)
            this.moves.push({x: x, y: y})
        end
    end

    method useQueuedMove()
        if len(this.moves) > 0
            let move = this.moves.shift()
            change this.dx = move.x
            change this.dy = move.y
        end
    end

    method readKeys()
        if key("r") || key("R")
            this.reset()
        end

        if key("q") || key("Q")
            change this.running = false
        end

        if key("w") || key("W") || key("ArrowUp")
            if !this.upPressed
                this.queueMove(0, -this.size)
            end
            change this.upPressed = true
        else
            change this.upPressed = false
        end

        if key("s") || key("S") || key("ArrowDown")
            if !this.downPressed
                this.queueMove(0, this.size)
            end
            change this.downPressed = true
        else
            change this.downPressed = false
        end

        if key("a") || key("A") || key("ArrowLeft")
            if !this.leftPressed
                this.queueMove(-this.size, 0)
            end
            change this.leftPressed = true
        else
            change this.leftPressed = false
        end

        if key("d") || key("D") || key("ArrowRight")
            if !this.rightPressed
                this.queueMove(this.size, 0)
            end
            change this.rightPressed = true
        else
            change this.rightPressed = false
        end
    end

    method move()
        this.useQueuedMove()

        let head = {x: this.snake[0].x + this.dx, y: this.snake[0].y + this.dy}

        if head.x < 0 || head.x >= 400 || head.y < 0 || head.y >= 400
            change this.alive = false
        end

        let i = 0
        while i < len(this.snake)
            if head.x == this.snake[i].x && head.y == this.snake[i].y
                change this.alive = false
            end
            change i = i + 1
        end

        if this.alive
            this.snake.unshift(head)

            if head.x == this.food.x && head.y == this.food.y
                change this.score = this.score + 1
                change this.food = this.newFood()
            else
                this.snake.pop()
            end
        end
    end

    method draw()
        clear "black"

        fill "#22c55e"
        let part = 0
        while part < len(this.snake)
            box this.snake[part].x this.snake[part].y this.size
            change part = part + 1
        end

        fill "#ef4444"
        box this.food.x this.food.y this.size

        pen "white" 1
        text 12 28 "Score:" 20
        text 82 28 this.score 20

        if !this.alive
            text 120 205 "Game Over" 32
            text 108 238 "Press R to restart" 18
        end

        if !this.running
            text 150 205 "Quit" 32
        end
    end

    method run()
        while this.running
            this.readKeys()

            if this.alive
                this.move()
            end

            this.draw()
            wait 120
        end

        this.draw()
    end
end

let game = new SnakeGame()
game.run()

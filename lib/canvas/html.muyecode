# Muyecode canvas header

cmp "canvas"

declare canvas(width, height, background)
declare pen(color, width)
declare fill(color)
declare line(x1, y1, x2, y2)
declare rect(x, y, width, height)
declare box(x, y, size)
declare circle(x, y, radius)
declare text(x, y, message, size)
declare clear(color)
declare key(name)
declare pressed(name)

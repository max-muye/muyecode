# Muyecode native GUI header

get "canvas/html"

cmp "gui"

declare window(width, height, title)
declare title(text)
declare background(color)
declare heading(x, y, width, height, text, size)
declare label(x, y, width, height, text, size)
declare button(x, y, width, height, text)
declare textbox(x, y, width, height, text)
declare inputbox(x, y, width, height, text)
declare password(x, y, width, height, text)
declare textarea(x, y, width, height, text)
declare checkbox(x, y, width, height, text, checked)
declare switch(x, y, width, height, text, checked)
declare radio(x, y, width, height, text, checked)
declare slider(x, y, width, height, min, max, value)
declare progress(x, y, width, height, min, max, value)
declare dropdown(x, y, width, height, item1, item2)
declare select(x, y, width, height, item1, item2)
declare date(x, y, width, height)
declare separator(x, y, width, height)
declare image(x, y, width, height, path)
